{
 "kind": "meta",
 "note": "Shared data of the story-event module (modules/events_world.mjs): recipient groups, AI presets, Eindil's pulse, the lastwar and lore extras, the secret rules and the names expected from other slices. Notation: lib/ew_script.mjs.",
 "aiPresets": {
  "friend": [
   {
    "factor": 2,
    "if": [
     "check_variable = { zin_eindil_regard > 24.999 }"
    ]
   }
  ],
  "hinder": [
   {
    "factor": 3,
    "if": [
     "check_variable = { zin_footholds > 2.999 }"
    ]
   },
   {
    "factor": 2,
    "if": [
     "has_government = fascism",
     "has_idea = zin_stance_zin_dom_warlord"
    ]
   },
   {
    "factor": 0,
    "if": [
     {
      "or": [
       "has_idea = zin_stance_zin_light_wardens",
       "has_idea = zin_stance_zin_light_sanctuary"
      ]
     }
    ]
   }
  ]
 },
