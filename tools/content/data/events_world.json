 "eindil": {
  "effects": {
   "zin_eindil_after_host_raised": {
    "note": "After the Host of Eindil exists (the .92 options, or the journey stage 9 runner): invitations to ride with the heir (humans), the coalition and the Lost Cause. Once only. Scope: any.",
    "do": [
     {
      "if": [
       "NOT = { has_global_flag = zin_eindil_invites_sent }"
      ],
      "then": [
       "@gflag zin_eindil_invites_sent",
       "@fire zin_eindil.93 days=1 to=group:ride_with_heir",
       "@fire zin_eindil.94 days=7 to=group:coalition_invitees",
       "@fire zin_eindil.95 days=7 to=group:lost_cause_leader"
      ]
     }
    ]
   }
  }
 },
 "lastwar": {
  "prelude": [
   "set_temp_variable = { zin_lastwar_fronts = 0 }",
   {
    "if": [
     "has_global_flag = zin_western_crossing"
    ],
    "then": [
     "add_to_temp_variable = { zin_lastwar_fronts = 1 }"
    ]
   },
   {
    "if": [
     "has_global_flag = zin_leren_withdrawal"
    ],
    "then": [
     "add_to_temp_variable = { zin_lastwar_fronts = 1 }"
    ]
   },
   {
    "if": [
     "has_global_flag = zin_zol_rising"
