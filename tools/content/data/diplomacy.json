  "joiningRules": [
    {
      "key": "concord",
      "name": "Crowns of the Middle Lands and Their Vassals",
      "trigger": [
        "OR = {",
        "capital_scope = { zin_is_region_middle_lands = yes }",
        "is_subject_of = FROM",
        "AND = {",
        "has_global_flag = zin_lost_cause_shield",
        "has_country_flag = zin_lost_cause_member",
        "}",
        "}"
      ]
    },
    {
      "key": "leren",
      "name": "Crowns of the North and the Dark Shore",
      "trigger": [
        "OR = {",
        "zin_leren_is_north_crown = yes",
        "zin_leren_is_dark_shore = yes",
        "is_subject_of = FROM",
        "AND = {",
        "tag = TAG[Andos Enda]",
        "has_country_flag = zin_refusal_lifted",
        "}",
        "}"
      ]
    },
    {
      "key": "cold_lands",
      "name": "Crowns of the Cold Lands",
      "trigger": [
        "OR = {",
        "capital_scope = { zin_is_region_cold_lands = yes }",
        "is_subject_of = FROM",
        "}"
      ]
    },
    {
      "key": "east_lands",
      "name": "Courts of the East Lands",
      "trigger": [
        "OR = {",
        "capital_scope = { zin_is_region_east_lands = yes }",
        "is_subject_of = FROM",
        "}"
      ]
    },
    {
      "key": "dark_lands",
      "name": "Holds of the Dark Lands",
      "trigger": [
        "OR = {",
        "capital_scope = { zin_is_region_dark_lands = yes }",
        "is_subject_of = FROM",
        "}"
      ]
    },
    {
      "key": "no_refusal",
      "name": "Realms Not Bound by the Elven Refusal",
      "trigger": [
        "NOT = { zin_diplo_refusal_binds = yes }"
      ]
    },
    {
      "key": "not_shadow",
      "name": "Realms Not of the Shadow",
      "trigger": [
        "NOT = { has_government = communism }"
      ]
    },
    {
      "key": "sworn",
      "name": "Realms Sworn to the Southern Dominion",
      "trigger": [
        "OR = {",
        "is_subject_of = FROM",
        "capital_scope = {",
        "OR = {",
        "zin_is_region_dead_lands = yes",
        "zin_is_region_dark_lands = yes",
        "}",
        "}",
        "}"
      ]
    },
    {
      "key": "crossing",
      "name": "Crowns of the West and the Isles",
      "trigger": [
        "OR = {",
        "has_country_flag = zin_region_west_lands",
        "has_country_flag = zin_region_tritons_islands",
        "AND = {",
        "has_global_flag = zin_cold_joins_crossing",
        "has_country_flag = zin_region_cold_lands",
        "}",
        "}"
      ]
    },
    {
      "key": "pupor_charter",
      "name": "Chart Houses of the Triton's Islands",
      "trigger": [
        "has_country_flag = zin_region_tritons_islands",
        "NOT = { has_country_flag = zin_tritons_corsair_haven }"
      ]
    },
    {
      "key": "free_north",
      "name": "Free Crowns of the North Lands",
      "trigger": [
        "capital_scope = { zin_is_region_north_lands = yes }",
        "NOT = { tag = TAG[Lerendor] }",
        "NOT = { is_in_faction_with = TAG[Lerendor] }",
        "NOT = { has_government = communism }",
        "check_variable = { var = zin_leren_lean value = -40 compare = greater_than_or_equals }",
        "check_variable = { var = zin_leren_lean value = 40 compare = less_than_or_equals }"
      ]
    },
    {
      "key": "warden_league",
      "name": "Friends of the Warden League",
      "trigger": [
        "has_country_flag = zin_mirolon_league_friend"
      ]
    },
    {
      "key": "free_steadings",
      "name": "Clan Realms of the Cold Lands",
      "trigger": [
        "zin_cold_is_clan_realm = yes",
        "is_subject = no",
        "check_variable = { var = zin_cold_lean value = -30 compare = greater_than_or_equals }",
        "check_variable = { var = zin_cold_lean value = 30 compare = less_than_or_equals }"
      ]
    },
    {
      "key": "free_dominions",
      "name": "Dominions That Broke from Parim",
      "trigger": [
        "has_country_flag = zin_aenor_free_dominion"
      ]
    },
    {
      "key": "lost_cause",
      "name": "Those Who Honour the Heir",
      "trigger": [
        "OR = {",
        "check_variable = { var = zin_eindil_regard value = 25 compare = greater_than_or_equals }",
        "has_country_flag = zin_west_stranded",
        "has_country_flag = zin_east_companies_with_eindil",
        "}"
      ]
    },
    {
      "key": "elven_kin",
      "name": "Elven Realms of the Magical Lands",
      "elsewhere": "elves",
      "trigger": [
        "zin_elves_is_magical_realm = yes"
      ]
    },
    {
      "key": "sun_realms",
      "name": "Realms of the Lands of the Sun",
      "elsewhere": "sun",
      "trigger": [
        "zin_sun_is_lands_of_the_sun_country = yes",
        "OR = {",
        "has_country_flag = zin_people_sun_elves",
        "has_country_flag = zin_people_elves",
        "}"
      ]
    }
  ],
