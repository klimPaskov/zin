{
  "schema": 1,
  "owner": "docs/specs/07_interface/05_text_sweep.md",
  "game": "1.19.3.0",
  "note": "Data for tools/content/checks/text_scan.mjs. A rule is a regular expression without delimiters. Matching is on the text a player reads: the value after glossary expansion, with colour codes, icon codes, $VARIABLE$ placeholders, [calls] and \\n removed, split on whole words. Rules are case-insensitive unless caseSensitive is true. Severity error fails the build. Severity review is reported and must be reworded or carry an allowance before the stage-4 gate.",
  "matching": {
    "normalise": "NFKC; remove colour codes (a section sign and one character); remove icon codes (a pound sign, the name and an optional frame); remove $...$ and [...]; replace \\n with a space; keep apostrophes inside words; a hyphen separates words",
    "wordBoundary": "A word is a run of letters, digits and apostrophes; a hyphen separates words. The scanner wraps every pattern so that it matches whole words only, which a hyphen does not prevent (anti-tank still hits tank).",
    "nested": "A $KEY$ whose KEY is a localisation key is expanded recursively (depth 6) before matching, so a nested vanilla key cannot hide a banned word",
    "keysAreNotText": "Localisation keys, engine ids and file names are never matched; only displayed values"
  },
  "classes": {
    "modern_industry": "Industry, energy, materials, devices, weapons and vehicles that Erdae does not have",
    "units_of_measure": "Metric and modern units; the world measures in miles, days of march, paces, pounds and loads",
    "modern_society": "Modern states, offices, ideologies and blocs",
    "military_modern": "Modern ranks and formations, and the words the glossary renames",
    "real_world": "Real countries, places, people, forces, months, weekdays and years",
    "third_party_ip": "Fiction that is not the owner's",
    "game_and_platform": "The base game, its publisher and its platforms",
    "superseded_names": "Retired Erdae names (02_lore/03_names_and_terms.md)",
    "us_spelling": "American spellings; ZIN text is British English"
  },
