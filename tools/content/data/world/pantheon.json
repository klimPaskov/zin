  "established": [
    "Aoaz has twelve main New Gods; they answer the twelve needs of mortals; the twelve months are named after them, one god per month (owner, 24 October 2026).",
    "Glernaen, New God of power and wisdom, is the mightiest of the twelve (owner, 24 October 2026).",
    "Lesser New Gods exist besides the twelve, have no month, and are stronger than most Great Spirits (owner, 24 October 2026; the comparison with spirits is sealed, C27).",
    "Afrit is publicly recognised as a New God at the end of the Third Age; his cult adds a feast, not a month (owner, 24 October 2026; his true order is mystery-open, C15).",
    "The game starts on the first day of the third month of 4A 1748 (owner situation of 18 October 2026)."
  ],
  "notes": {
    "regionalNames": "Keys are language ids of tools/content/data/world/languages.json. aenoran, leren, mirolic and dondric forms are the regular reflexes of the Old Ainic name under each daughter's ordered sound laws; the other languages give a calque epithet built from their own dictionary and join rules. pantheon.md section 5 shows every derivation.",
    "monthForms": "monthName is the value of the engine's full month key; monthAbbr (at most 4 letters) is the value of the engine's short key; monthShort is the clipped everyday form for compact prose and is never written to an engine key. The engine key May serves both forms, so month 5 shows monthName in both places.",
    "encoding": "Every name is plain ASCII, so it is valid Windows-1252 and every game font draws it.",
    "layers": "Facts marked sealed or gated never reach player text outside their gate; see knowledge_layers.md. servesZol and overthrownBy are sealed authorial data and must not be copied into localisation."
  },
  "needs": [
    { "id": "rule_counsel", "order": 1, "name": "Strength and counsel", "kinds": ["social", "spiritual"], "covers": "Rightful power, wise rule, good counsel, learning, the reckoning of stores; the need to be able to act and to know how", "god": "glernaen" },
    { "id": "healing", "order": 2, "name": "Healing", "kinds": ["personal", "practical"], "covers": "Health of body and mind, clean water, care of the sick, mercy at the sickbed", "god": "sulethe" },
    { "id": "shelter", "order": 3, "name": "Shelter and the hearth", "kinds": ["practical", "personal"], "covers": "A roof, a fire, a lit window, the household and the common people who keep it", "god": "lumae" },
    { "id": "waters_weather", "order": 4, "name": "Fair weather and safe waters", "kinds": ["practical"], "covers": "Rain in its season, rivers that rise and fall as they should, winds and seas that let ships come home", "god": "maelwen" },
    { "id": "kin_birth", "order": 5, "name": "Kin and birth", "kinds": ["personal", "social"], "covers": "Children, safe childbirth, marriage, the bond of kin, the increase of flocks", "god": "vaelei" },
    { "id": "roads_exchange", "order": 6, "name": "Safe roads and fair exchange", "kinds": ["social", "practical"], "covers": "Travel, markets, the welcome of strangers, heralds and envoys, the goods that one land lacks and another has", "god": "rasthel" },
    { "id": "protection", "order": 7, "name": "Protection", "kinds": ["social"], "covers": "Walls, watch and defence of the weak; war only to keep the people safe", "god": "kerun" },
    { "id": "food", "order": 8, "name": "Daily bread", "kinds": ["practical"], "covers": "Harvest, grain, the ploughed field, granaries and relief in famine", "god": "aurlan" },
    { "id": "justice_oaths", "order": 9, "name": "Justice and kept promises", "kinds": ["social"], "covers": "Oaths, contracts, fair measure, boundaries, the settling of debts, judgement", "god": "ailtal" },
    { "id": "craft_work", "order": 10, "name": "Skill and work", "kinds": ["practical", "social"], "covers": "Craft, forge and kiln, building, tools, apprenticeship, the dignity of labour", "god": "irumas" },
    { "id": "death_passage", "order": 11, "name": "A good death and remembrance", "kinds": ["spiritual"], "covers": "Passage, funerals, mourning, the names of the dead kept, the forgotten remembered", "god": "gaelor" },
    { "id": "hope_fortune", "order": 12, "name": "Hope and fortune", "kinds": ["spiritual", "personal"], "covers": "Hope in the dark, luck and lots, the turning of the year, the stars that guide by night", "god": "naisa" }
