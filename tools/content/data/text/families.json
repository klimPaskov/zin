  "ownership": [
    {
      "owner": "calendar.mjs",
      "source": "lib/calendar.mjs monthKeys()",
      "reason": "The month names and their short forms are the calendar's (spec 05 section 5)"
    },
    {
      "owner": "frontend.mjs",
      "match": "^(FE_DIFFICULTY_[A-Z_]+|ZIN_MENU_[A-Z_]+)$",
      "reason": "Main-menu difficulty and menu wording is the frontend spec's; the realm-side diff_*_player names are the difficulty family's"
    },
    {
      "owner": "interface modules",
      "match": "^(WORLD_TENSION_NAME|ZIN_[A-Z0-9_]+)$",
      "reason": "The Gathering Dark label and every ZIN_ key belong to the interface modules"
    }
  ],
  "otherFiles": [
    {
      "match": "^(music|musicplayer|alliedradio|allied_speeches|germanmarchorder|radio_pack_soundtrack|sabatonsoundtrack|songs_of_the_eastern_front|.+_music)$",
      "mode": "owned",
      "reason": "Music titles belong to the music and sound spec (04_music_and_sound)"
    },
    {
      "match": "^(state_names|strategic_region_names|supply_area_names|victory_points)$",
      "mode": "owned",
      "reason": "Map names belong to the map track"
    },
    {
      "match": "^tutorial$",
      "mode": "owned",
      "reason": "The tutorial is hidden; the frontend spec owns its text"
    },
    {
      "match": "^.+$",
      "mode": "content",
      "reason": "Vanilla focus, event, idea, decision, character, country, party and DLC text; only kept engine ids are reachable and they move into families by ownership"
    }
  ],
  "exempt": [
    {
      "match": "^(africa|asia|europe|north_america|south_america)(_adj)?$",
      "reason": "The ZIN map assigns only the three continents world_continent_1 to 3 (map/definition.csv); the real-world continent names are never shown"
    },
    {
      "match": "^ace_[A-Za-z_]+_desc$",
      "reason": "Descriptions of named real pilots; their portraits are unreachable (docs/specs/07_interface/06_career_honours.md section 10)"
    },
    {
      "match": "^AIR_WING_NAME_[A-Z]{3}_(FALLBACK|GENERIC)$",
      "reason": "Wing names of vanilla tags; ZIN tags have none and the engine falls back to AIR_WING_NAME_FALLBACK"
    },
    {
      "match": "^((SUEZ|PANAMA)_CANAL(_BLOCKED(_FOR_COUNTRY)?)?|SUEZ_SANCTIONS_FLAG|(BOSPHORUS|DARDANELLES|GIBRALTAR|HORMUZ|OTRANTO|DANISH_BELTS)_STRAIT(_BLOCKED(_FOR_COUNTRY)?)?|KIEL_CANAL)$",
      "reason": "Names of real straits and canals; ZIN's map/adjacency_rules.txt defines none yet, and the map step will name its own straits (docs/specs/01_map/02_key_sites.md)"
    },
    {
      "match": "^FOCUS_FILTER_(CHI|FRA|GRE|ITA|MEX|SOV|SPA|SWI|TFV|TUR|USA)_[A-Z_]+$|^FOCUS_FILTER_(FOLKHEMMET|INNER_CIRCLE|IMPERIAL_INFLUENCE)$",
      "reason": "Filters of vanilla country focus trees, which stage 1 removed; ZIN trees use the generic filters"
    }
  ]
}
