{
  "version": 1,
  "note": "Path rules of the asset manifest (docs/specs/08_art_and_assets/05_asset_manifest.md section 2). The first rule whose regex matches a shipped file decides its family, subject key, kind, uniqueness group and source. $1..$n are the regex groups. 'source' names the tracked generated picture the file is cut from when no module manifest line says so; 'route' is imagegen, meshy, synth, derived or kept. Families I1, D7, A3, G2 and F-chrome use the ids of 03_full_asset_inventory.md; M (map files), S (sound), MU (music), FN (fonts) and U (not yet classified) are proposed here.",
  "specs": {
    "A1": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "A3": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "D7": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "E1": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "F1": "docs/specs/08_art_and_assets/02_loading_screens_and_quotes.md",
    "F2": "docs/specs/08_art_and_assets/02_loading_screens_and_quotes.md",
    "F3": "docs/specs/07_interface/03_main_menu_and_frontend.md",
    "G2": "docs/specs/07_interface/01_interface.md",
    "I1": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "I3": "docs/specs/07_interface/02_full_ui_reskin.md",
    "K": "docs/specs/08_art_and_assets/03_full_asset_inventory.md",
    "M": "docs/specs/01_map/04_map_overhaul_plan.md",
    "S": "docs/specs/08_art_and_assets/04_music_and_sound.md",
    "MU": "docs/specs/08_art_and_assets/04_music_and_sound.md",
    "FN": "docs/specs/08_art_and_assets/05_asset_manifest.md",
    "U": "docs/specs/08_art_and_assets/05_asset_manifest.md"
  },
  "rules": [
    { "id": "flag_large", "match": "^gfx/flags/([A-Za-z0-9]{3})\\.tga$", "family": "I1", "key": "$1", "kind": "flag", "group": "flag.large", "bound_by": "flag_tag", "route": "imagegen", "flagTag": "$1" },
    { "id": "flag_medium", "match": "^gfx/flags/medium/([A-Za-z0-9]{3})\\.tga$", "family": "I1", "key": "$1", "kind": "flag", "group": "flag.medium", "bound_by": "flag_tag", "route": "imagegen", "flagTag": "$1" },
    { "id": "flag_small", "match": "^gfx/flags/small/([A-Za-z0-9]{3})\\.tga$", "family": "I1", "key": "$1", "kind": "flag", "group": "flag.small", "bound_by": "flag_tag", "route": "imagegen", "flagTag": "$1" },
    { "id": "people_focus_emblem", "match": "^gfx/interface/goals/zin/people_([a-z_]+)\\.dds$", "family": "A3", "key": "people_$1_focus", "kind": "focus_icon", "group": "focus_icon", "bound_by": "sprite", "route": "imagegen", "people": "$1", "source": "art/source/emblems/emblems-peoples.png" },
    { "id": "focus_icon", "match": "^gfx/interface/goals/zin/([a-z0-9_]+)\\.dds$", "family": "A1", "key": "$1", "kind": "focus_icon", "group": "focus_icon", "bound_by": "sprite", "route": "imagegen" },
    { "id": "idea_icon", "match": "^gfx/interface/ideas/zin/([a-z0-9_]+)\\.dds$", "family": "A1", "key": "$1", "kind": "idea_icon", "group": "idea_icon", "bound_by": "sprite", "route": "imagegen" },
    { "id": "people_emblem", "match": "^gfx/interface/ideas/zin_people_([a-z_]+)\\.dds$", "family": "A3", "key": "people_$1", "kind": "idea_icon", "group": "people_emblem", "bound_by": "sprite", "route": "imagegen", "people": "$1", "source": "art/source/emblems/emblems-peoples.png" },
    { "id": "event_picture", "match": "^gfx/event_pictures/zin/zin_evt_([a-z0-9_]+)\\.dds$", "family": "E1", "key": "$1", "kind": "event_picture", "group": "event_picture", "bound_by": "sprite", "route": "imagegen" },
    { "id": "news_picture", "match": "^gfx/event_pictures/zin/zin_news_([a-z0-9_]+)\\.dds$", "family": "E1", "key": "$1", "kind": "news_picture", "group": "news_picture", "bound_by": "sprite", "route": "imagegen" },
    { "id": "super_event_picture", "match": "^gfx/event_pictures/zin/super_events/zin_se_([a-z0-9_]+)\\.dds$", "family": "E1", "key": "se_$1", "kind": "super_event_picture", "group": "super_event_picture", "bound_by": "sprite", "route": "imagegen" },
    { "id": "portrait_generic", "match": "^gfx/leaders/zin/([a-z_]+)_(male|female)_([0-9]+)\\.dds$", "family": "D7", "key": "$1_$2_$3", "kind": "portrait_large", "group": "portrait.$1.$2", "bound_by": "sprite", "route": "imagegen", "people": "$1", "source": "art/source/portraits/portraits-$1.png" },
    { "id": "loading_screen", "match": "^gfx/loadingscreens/(load_[0-9]+)\\.dds$", "family": "F1", "key": "$1", "kind": "loading_screen", "group": "scene", "bound_by": "path_convention", "route": "imagegen" },
    { "id": "loading_thumb_border", "match": "^gfx/interface/zin/loadingscreens/(zin_thumb_border)\\.dds$", "family": "F1", "key": "chrome_$1", "kind": "frontend", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "loading_thumb", "match": "^gfx/interface/zin/loadingscreens/(load_[0-9]+)_small\\.dds$", "family": "F1", "key": "$1", "kind": "loading_screen", "group": "scene.thumb", "bound_by": "sprite", "route": "imagegen" },
    { "id": "menu_background", "match": "^gfx/loadingscreens/zin_menu_([a-z0-9_]+)\\.dds$", "family": "F2", "key": "$1", "kind": "menu_background", "group": "scene", "bound_by": "sprite", "route": "imagegen" },
    { "id": "menu_thumb", "match": "^gfx/interface/zin/loadingscreens/zin_menu_([a-z0-9_]+)_small\\.dds$", "family": "F2", "key": "$1", "kind": "menu_background", "group": "scene.thumb", "bound_by": "sprite", "route": "imagegen" },
    { "id": "loading_chrome", "match": "^gfx/interface/([Ll]oading[Ss]creen_[A-Za-z0-9_]+)\\.dds$", "family": "F1", "key": "chrome_$1", "kind": "frontend", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "logo", "match": "^gfx/interface/logo_game\\.dds$", "family": "F3", "key": "logo_game", "kind": "frontend", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "bookmark", "match": "^gfx/interface/bookmarks/(zin_[a-z0-9_]+)\\.dds$", "family": "F3", "key": "$1", "kind": "frontend", "group": "scene", "bound_by": "sprite", "route": "imagegen" },
    { "id": "select_date", "match": "^gfx/interface/(select_date_[0-9]+)\\.dds$", "family": "F3", "key": "$1", "kind": "frontend", "group": "scene", "bound_by": "path_convention", "route": "imagegen" },
    { "id": "zin_ui_people_strip", "match": "^gfx/interface/zin/(people_strip)\\.dds$", "family": "G2", "key": "$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/emblems/emblems-peoples.png" },
    { "id": "zin_ui_chrome", "match": "^gfx/interface/zin/chrome/([a-z_]+)\\.dds$", "family": "G2", "key": "chrome_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/ui-zin-chrome.png" },
    { "id": "zin_ui_header", "match": "^gfx/interface/zin/headers/([a-z_]+)\\.dds$", "family": "G2", "key": "header_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/headers/$1.png" },
    { "id": "zin_ui_dialogs", "match": "^gfx/interface/zin/dialogs/([a-z_]+)\\.dds$", "family": "G2", "key": "dialogs_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "zin_ui_chancery", "match": "^gfx/interface/zin/chancery/([a-z_]+)\\.dds$", "family": "G2", "key": "chancery_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "zin_ui_research", "match": "^gfx/interface/zin/research/([a-z_]+)\\.dds$", "family": "G2", "key": "research_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "zin_faction_emblems", "match": "^gfx/interface/factions/zin/([a-z0-9_]+)\\.dds$", "family": "G2", "key": "faction_$1", "kind": "stat_icon", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "zin_ui_frontend", "match": "^gfx/interface/zin/frontend/([a-z_]+)\\.dds$", "family": "G2", "key": "frontend_ui_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen" },
    { "id": "zin_ui_unknown", "match": "^gfx/interface/zin/unknown/([a-z_]+)\\.dds$", "family": "G2", "key": "unknown_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/ui-zin-chrome.png" },
    { "id": "zin_aoaz_meters_1", "match": "^gfx/interface/zin/aoaz/meters_1\\.dds$", "family": "G2", "key": "aoaz_meters_1", "kind": "stat_icon", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/aoaz/ui-aoaz-meters-1.png" },
    { "id": "zin_aoaz_meters_2", "match": "^gfx/interface/zin/aoaz/meters_2\\.dds$", "family": "G2", "key": "aoaz_meters_2", "kind": "stat_icon", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/aoaz/ui-aoaz-meters-2.png" },
    { "id": "zin_aoaz_sigils", "match": "^gfx/interface/zin/aoaz/(sigil_[a-z_]+|button)\\.dds$", "family": "G2", "key": "aoaz_$1", "kind": "stat_icon", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/aoaz/ui-aoaz-sigils.png" },
    { "id": "zin_aoaz_frame", "match": "^gfx/interface/zin/aoaz/bar_frame\\.dds$", "family": "G2", "key": "aoaz_bar_frame", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/reskin/ui-chrome-banner-hall.png" },
    { "id": "zin_mapmode_buttons", "match": "^gfx/interface/zin/mapmodes/([a-z_]+)\\.dds$", "family": "G2", "key": "mapmode_$1", "kind": "map_icon", "group": "ui", "bound_by": "sprite", "route": "imagegen", "source": "art/source/ui/reskin/icons-topbar-values.png" },
    { "id": "unit_model", "match": "^gfx/models/units/zin/([a-z0-9_]+)/(.+)$", "family": "K", "key": "$1", "kind": "model", "group": "unit_look", "bound_by": "entity", "route": "meshy", "job": "docs/assets/hoi4_3d_model_jobs/models_3d/$1", "people": "", "reach": "visible" },
    { "id": "cursor", "match": "^gfx/cursors/([A-Za-z0-9_]+)\\.(cur|ani|png|ico)$", "family": "I3", "key": "$1", "kind": "cursor", "group": "cursor", "bound_by": "cursor_name", "route": "imagegen" },
    { "id": "font", "match": "^gfx/fonts/(.+)\\.(fnt|dds|tga|png)$", "family": "FN", "key": "$1", "kind": "font", "group": "font", "bound_by": "font_asset", "route": "kept" },
    { "id": "map_file", "match": "^map/(.+)\\.(bmp|dds|png|tga)$", "family": "M", "key": "$1", "kind": "map_texture", "group": "map_tile", "bound_by": "map_file", "route": "derived", "reach": "engine" },
    { "id": "music", "match": "^music/(.+)\\.(ogg|mp3|wav)$", "family": "MU", "key": "$1", "kind": "music", "group": "music", "bound_by": "music_asset", "route": "synth" },
    { "id": "sound", "match": "^sound/(.+)\\.(wav|ogg)$", "family": "S", "key": "$1", "kind": "sound", "group": "sound", "bound_by": "sound_effect", "route": "synth" },
    { "id": "technology_blank", "match": "^gfx/interface/technologies/zin/(blank)\\.dds$", "family": "G2", "key": "technology_$1", "kind": "ui_panel", "group": "ui", "bound_by": "sprite", "route": "derived" },
    { "id": "unclassified_image", "match": "^((?:gfx|interface)/.+)\\.(dds|tga|png)$", "family": "U", "key": "$1", "kind": "ui_chrome", "group": "ui", "bound_by": "sprite", "route": "imagegen" }
  ]
}
