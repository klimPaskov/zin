# Local transient evidence and logs
*.log
.tmp/
.cache/
artifacts/private/

# Private original reference art; generated mod assets are tracked
docs/reference/originals/

# Editor and OS metadata
.DS_Store
Thumbs.db

# Agentic HOI4 Modding kit: machine-local 3D bootstrap caches and runtime records
/.tools/3d_pipeline/vendor/
/.tools/3d_pipeline/**/__pycache__/
/.tools/3d_pipeline/adapter/.venv/
/.tools/3d_pipeline/adapter/uv.lock
/.tools/3d_pipeline/config/runtime.json
/.tools/3d_pipeline/config/meshy_mcp_version.txt
/.tools/3d_pipeline/config/blender_mcp_project.txt
/.tools/3d_pipeline/config/uv_executable.txt
/.tools/3d_pipeline/config/blender_mcp_host.txt
/.tools/3d_pipeline/config/blender_mcp_port.txt
/.agents/skills/**/__pycache__/
# Kit reference material from third parties stays on disk for agents but out of ZIN's history
/paradox_wiki/
/.agents/skills/**/vanilla_reference/
/.claude/skills/**/vanilla_reference/
/.claude/skills/**/__pycache__/
# The owner's original drawings in the lore vault stay private (owner decision, 18 October 2026)
/docs/lore/vault/Maps/

# 3D pipeline job roots: bulky working files stay on disk as pipeline evidence, out of history. Kept: refs,
# job.yaml, manifest, history, runtime handoffs, validation and Blender JSON reports. The shipped models live in
# gfx/models/units/zin/ (hashes recorded in each runtime/handoff.md).
/docs/assets/hoi4_3d_model_jobs/**/blender/*
!/docs/assets/hoi4_3d_model_jobs/**/blender/reports/
/docs/assets/hoi4_3d_model_jobs/**/provider/downloads/
/docs/assets/hoi4_3d_model_jobs/**/logs/
/docs/assets/hoi4_3d_model_jobs/**/export/
/docs/assets/hoi4_3d_model_jobs/**/textures/
